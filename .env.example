# FindBack environment template. Copy to .env and fill in.
# NEVER commit a real .env file to Git.

# --- Flask ---
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-me-to-a-random-value
# FLASK_COOKIE_SECURE=1  # Set to 1 when serving over HTTPS; defaults on when FLASK_DEBUG=0.
# HOST=127.0.0.1
# PORT=5000

# --- Storage backend: csv (default) or supabase ---
# FINDBACK_STORE=

# --- Optional weak-match filter (0.0 - 1.0, unset = show all) ---
# FINDBACK_MIN_SCORE=

# --- Supabase (leave empty for local CSV mode) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-side trusted writes ONLY (one-off migration
# + match notification writer in src/notify.py). Never the browser,
# never Git, never templates, never logs.
# SUPABASE_SERVICE_ROLE_KEY=
